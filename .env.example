# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

APP_NAME="SUME"
# development | production  (em produção, erros não são exibidos na tela)
APP_ENV=development
# Deixe vazio para detectar automaticamente (ex.: http://localhost/SUME)
APP_URL=
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sume_db
DB_USERNAME=root
DB_PASSWORD=

# Pontuação do ranking
POINTS_CONFIRMATION=10
POINTS_FEEDBACK=5

# Horário limite (HH:MM) para confirmar/cancelar presença na refeição do dia.
# Deixe vazio para não ter limite.
CONFIRMATION_DEADLINE=10:00

# SMTP do formulário de contato (ex.: Brevo, Gmail com senha de app etc.)
# Se MAIL_HOST ficar vazio, o formulário mostra um aviso em vez de enviar.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SUME"
# Para onde as mensagens de contato são enviadas
MAIL_SUPPORT_ADDRESS=
