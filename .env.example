# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

APP_NAME="SUME"
# development | production  (em produção, erros não são exibidos na tela)
APP_ENV=development
# Deixe vazio para detectar automaticamente (ex.: http://localhost/SUME)
APP_URL=
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sume_db
DB_USERNAME=root
DB_PASSWORD=

# Pontuação do ranking
# Ganhos quando a cozinha marca que o aluno retirou a refeição
POINTS_PICKUP=10
# Perdidos por quem confirmou e não retirou (aplicado quando a cozinha encerra a retirada do dia)
POINTS_NO_SHOW=5
POINTS_FEEDBACK=5

# Horário limite (HH:MM) para confirmar/cancelar presença na refeição do dia.
# Deixe vazio para não ter limite.
CONFIRMATION_DEADLINE=10:00

# E-MAIL (recuperação de senha e formulário de contato)
# smtp = envia de verdade | log = só grava em storage/logs/mail.log (para testar sem enviar)
MAIL_DRIVER=smtp
#
# Gmail: use uma "senha de app" (NÃO a senha normal da conta):
#   1. Ative a verificação em duas etapas em https://myaccount.google.com/security
#   2. Crie a senha de app em https://myaccount.google.com/apppasswords
#   3. Cole os 16 caracteres (sem espaços) em MAIL_PASSWORD
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sua.conta@gmail.com
MAIL_PASSWORD=
# No Gmail o remetente precisa ser a própria conta
MAIL_FROM_ADDRESS=sua.conta@gmail.com
MAIL_FROM_NAME="SUME"
# Para onde vão as mensagens do formulário de contato
MAIL_SUPPORT_ADDRESS=sua.conta@gmail.com

# LOGIN COM GOOGLE (opcional: sem isso, o botão "Entrar com Google" não aparece)
# Crie em https://console.cloud.google.com/apis/credentials  ->  "ID do cliente OAuth"  ->  "Aplicativo da Web"
# URI de redirecionamento autorizado:  http://localhost:8080/SUME/auth/google/callback
#   (ajuste host/porta/pasta para o endereço onde o SUME roda)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: aceitar só e-mails destes domínios, separados por vírgula (ex.: etec.sp.gov.br)
GOOGLE_ALLOWED_DOMAINS=
